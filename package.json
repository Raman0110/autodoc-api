{
  "name": "autodoc-api",
  "version": "0.4.0",
  "description": "Zero-annotation OpenAPI documentation for existing Node.js / TypeScript / Express APIs.",
  "license": "MIT",
  "author": "Raman Tamang <ramantamang556@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raman0110/autodoc-api.git"
  },
  "homepage": "https://github.com/Raman0110/autodoc-api#readme",
  "bugs": {
    "url": "https://github.com/Raman0110/autodoc-api/issues"
  },
  "keywords": [
    "openapi",
    "openapi3",
    "swagger",
    "api-documentation",
    "express",
    "typescript",
    "zod",
    "static-analysis",
    "documentation-generator",
    "scalar",
    "redoc"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "autodoc": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/demo.gif",
    "CHANGELOG.md",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/analyze.test.js test/cli.test.js test/middleware.test.js",
    "example": "npm run build && node dist/cli.js ./example/src --out ./example/openapi.json",
    "serve:example": "npm run build && node dist/cli.js serve ./example/src",
    "benchmark": "npm run build && node benchmark/run.js",
    "benchmark:setup": "node benchmark/setup.js",
    "benchmark:scale": "npm run build && node benchmark/scale.js",
    "benchmark:scale:setup": "node benchmark/scale-setup.js",
    "prepublishOnly": "npm test"
  },
  "dependencies": {
    "@seriousme/openapi-schema-validator": "2.11.0",
    "ajv": "^8.20.0",
    "typescript": ">=5.6.0 <7",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "express": "^4.21.0",
    "zod": "^4.6.7"
  }
}
